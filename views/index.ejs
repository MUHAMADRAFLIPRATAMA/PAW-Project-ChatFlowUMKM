<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>ChatFlow UMKM</title>
  <style>
    :root { font-family: "Segoe UI", Arial, sans-serif; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; color: #f8fafc; background: linear-gradient(rgba(15,23,42,.72), rgba(15,118,110,.7)), url('/images/umy.jpeg') center / cover fixed; }
    .phone { max-width: 980px; min-height: 100vh; margin: auto; overflow: hidden; }
    header { padding: 42px 28px 30px; background: rgba(255,255,255,.08); border-bottom: 1px solid rgba(255,255,255,.2); backdrop-filter: blur(14px); }
    .status { display: none; }
    .brand { display: flex; align-items: center; gap: 14px; }
    .avatar { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: rgba(255,255,255,.2); border: 1px solid rgba(255,255,255,.4); font-size: 22px; font-weight: 700; }
    h1, h2, h3, p { margin: 0; }
    h1 { font-size: 30px; }
    .subtitle { color: rgba(255,255,255,.72); font-size: 15px; margin-top: 4px; }
    main { max-width: 760px; margin: auto; padding: 30px 20px 60px; }
    .bubble { padding: 17px; margin-bottom: 16px; background: rgba(255,255,255,.13); border: 1px solid rgba(255,255,255,.2); border-radius: 16px; color: #fff; line-height: 1.5; font-size: 15px; backdrop-filter: blur(12px); }
    .bubble strong { display: block; color: #a7f3d0; margin-bottom: 4px; }
    .chat-log { display: grid; gap: 10px; margin-bottom: 14px; }
    .chat-message { max-width: 86%; padding: 12px 14px; border-radius: 15px; line-height: 1.4; font-size: 14px; }
    .chat-message.bot { background: rgba(255,255,255,.13); border: 1px solid rgba(255,255,255,.2); }
    .chat-message.user { justify-self: end; background: #34d399; color: #064e3b; }
    .chat-form { display: flex; gap: 8px; margin-bottom: 20px; }
    .chat-input { min-width: 0; flex: 1; padding: 13px 14px; border: 1px solid rgba(255,255,255,.25); border-radius: 11px; outline: 0; background: rgba(255,255,255,.12); color: white; font: inherit; }
    .chat-input::placeholder { color: rgba(255,255,255,.6); }
    .chat-send { padding: 0 18px; border: 0; border-radius: 11px; background: #34d399; color: #064e3b; font-weight: 700; cursor: pointer; }
    .chat-send:disabled { opacity: .6; cursor: progress; }
    .chat-hint { margin: -12px 0 18px; font-size: 12px; color: rgba(255,255,255,.55); }
    .chat-message.error { background: rgba(248,113,113,.16); border: 1px solid rgba(248,113,113,.45); }
    .typing-dots { display: inline-flex; gap: 4px; margin-left: 8px; vertical-align: middle; }
    .typing-dots i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: .3; animation: typing 1s infinite; }
    .typing-dots i:nth-child(2) { animation-delay: .15s; }
    .typing-dots i:nth-child(3) { animation-delay: .3s; }
    @keyframes typing { 0%, 100% { opacity: .25; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-3px); } }
    .menu, .panel { background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.22); border-radius: 16px; box-shadow: 0 12px 30px rgba(0,0,0,.12); backdrop-filter: blur(14px); }
    .menu { padding: 8px 18px; margin-bottom: 20px; }
    .choice { width: 100%; padding: 16px 0; border: 0; border-bottom: 1px solid rgba(255,255,255,.15); background: none; color: #fff; text-align: left; font: inherit; font-weight: 600; cursor: pointer; }
    .choice:last-child { border-bottom: 0; color: rgba(255,255,255,.75); }
    .panel { padding: 22px 18px; }
    .panel h2 { font-size: 22px; }
    .muted { color: rgba(255,255,255,.65); font-size: 14px; margin-top: 5px; }
    .products { display: grid; gap: 12px; margin-top: 18px; }
    article { display: flex; align-items: center; gap: 12px; padding: 10px; border: 1px solid rgba(255,255,255,.2); border-radius: 14px; background: rgba(255,255,255,.08); }
    .product-img { width: 72px; height: 72px; border-radius: 10px; object-fit: cover; }
    article h3 { font-size: 15px; margin: 5px 0; }
    .category { color: rgba(255,255,255,.6); font-size: 12px; }
    .price { color: #a7f3d0; font-size: 14px; font-weight: 700; }
    .quantity { width: 52px; margin-left: auto; padding: 9px 5px; border: 1px solid rgba(255,255,255,.3); border-radius: 9px; background: rgba(255,255,255,.15); color: white; text-align: center; font-size: 16px; }
    .primary { width: 100%; margin-top: 18px; padding: 14px; border: 0; border-radius: 11px; background: #34d399; color: #064e3b; font: inherit; font-weight: 700; cursor: pointer; }
    ol { padding-left: 22px; line-height: 2; color: rgba(255,255,255,.85); }
    .result { margin-top: 14px; padding: 14px; border-radius: 11px; background: rgba(167,243,208,.2); color: #a7f3d0; }
    .cart-item { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,.15); }
    .cart-item:last-child { border-bottom: 0; }
    .cart-info { flex: 1; } .cart-actions { display: flex; align-items: center; gap: 6px; }
    .cart-actions button { width: 28px; height: 28px; padding: 0; border: 0; border-radius: 6px; background: #34d399; color: #064e3b; font-weight: 700; cursor: pointer; }
    .cart-actions .remove { background: #fca5a5; color: #7f1d1d; }
    .hidden { display: none; }
    footer { padding: 24px 0; color: rgba(255,255,255,.6); text-align: center; font-size: 12px; }
    footer a { color: #a7f3d0; text-decoration: none; }
    @media (min-width: 500px) { .phone { min-height: 100vh; } }
  </style>
</head>
<body>
  <div class="phone">
    <header><div class="status"><span>9:41</span><span>● ● ▰</span></div><div class="brand"><div class="avatar">C</div><div><h1>ChatFlow UMKM</h1><p class="subtitle">Asisten pesanan kamu</p></div></div></header>
    <main>
      <div id="chatLog" class="chat-log"><div class="chat-message bot"><strong>ChatFlow Bot</strong>Halo! Saya ChatFlow Assistant. Tanya apa saja soal produk, harga, atau cara memesan di aplikasi ini.</div></div>
      <form id="chatForm" class="chat-form"><input id="chatInput" class="chat-input" autocomplete="off" maxlength="500" placeholder="Tanya soal produk, harga, atau cara pesan..." required><button class="chat-send" type="submit">Kirim</button></form>
      <p class="chat-hint">AI hanya menjawab seputar produk dan fitur ChatFlow UMKM.</p>
      <div class="menu"><button class="choice" data-target="catalog">Lihat katalog produk <span>›</span></button><button class="choice" data-target="guide">Panduan jualan online <span>›</span></button><button class="choice" data-target="help">Bantuan <span>›</span></button></div>
      <section id="catalog" class="panel hidden"><h2>Pilih produk</h2><p class="muted">Langkah 1 dari 3 · pilih produk dan jumlahnya</p><div class="products"><% products.forEach(product => { %><article><img src="<%= product.image %>" class="product-img" alt="<%= product.name %>"><div><span class="category"><%= product.category %></span><h3><%= product.name %></h3><span class="price">Rp <%= product.price.toLocaleString('id-ID') %></span></div><input class="quantity" type="number" min="0" value="0" data-name="<%= product.name %>" data-price="<%= product.price %>"></article><% }) %></div><button id="calculate" class="primary">Konfirmasi pesanan</button><div id="result"></div><div id="cart" class="hidden"><h3>Keranjang belanja</h3><p class="muted">Atur jumlah makanan sebelum melanjutkan.</p><div id="cartItems"></div><div class="result">Total: <strong id="cartTotal">Rp 0</strong></div><button id="continueOrder" class="primary">Lanjutkan pemesanan</button></div></section>
      <section id="guide" class="panel hidden"><h2>Panduan Jualan Online</h2><p class="muted">Tips singkat untuk mulai berjualan</p><ol><li>Foto produk dengan pencahayaan baik.</li><li>Tulis nama dan harga produk dengan jelas.</li><li>Bagikan katalog kepada calon pembeli.</li><li>Balas pesanan melalui alur ChatFlow.</li><li>Konfirmasi jumlah dan alamat pembeli.</li></ol></section>
      <section id="help" class="panel hidden"><h2>Bantuan</h2><p class="muted">Pilih menu katalog untuk memulai pesanan. Chatbot ini menggunakan template jawaban agar proses tetap cepat.</p></section>
      <footer>API: <a href="/api/status">status</a> · <a href="/api/produk">produk</a></footer>
    </main>
  </div>
  <script>
    const showSection = target => { document.querySelectorAll('section[id]').forEach(section => section.classList.add('hidden')); document.getElementById(target).classList.remove('hidden'); };
    document.querySelectorAll('.choice').forEach(button => button.onclick = () => showSection(button.dataset.target));
    const chatLog = document.getElementById('chatLog');
    const chatForm = document.getElementById('chatForm');
    const chatInput = document.getElementById('chatInput');
    const chatButton = document.querySelector('.chat-send');
    const chatHistory = [];
    const MAX_HISTORY = 20;

    const appendMessage = (role, text, extraClass) => {
      const bubble = document.createElement('div');
      bubble.className = ['chat-message', role, extraClass].filter(Boolean).join(' ');
      if (role === 'bot') {
        const title = document.createElement('strong');
        title.textContent = 'ChatFlow Bot';
        bubble.append(title, document.createTextNode(text));
      } else {
        bubble.textContent = text;
      }
      chatLog.append(bubble);
      bubble.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      return bubble;
    };

    const appendTyping = () => {
      const bubble = appendMessage('bot', '');
      bubble.innerHTML = '<strong>ChatFlow Bot</strong><span class="typing-dots"><i></i><i></i><i></i></span>';
      return bubble;
    };

    const remember = (message, reply) => {
      chatHistory.push({ role: 'user', text: message }, { role: 'model', text: reply });
      if (chatHistory.length > MAX_HISTORY) chatHistory.splice(0, chatHistory.length - MAX_HISTORY);
    };

    chatForm.onsubmit = async event => {
      event.preventDefault();
      const message = chatInput.value.trim();
      if (!message) return;

      appendMessage('user', message);
      chatInput.value = '';
      chatInput.disabled = true;
      chatButton.disabled = true;
      chatButton.textContent = 'Mengirim...';

      const typing = appendTyping();

      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message, history: chatHistory })
        });
        const payload = await response.json().catch(() => ({}));
        typing.remove();

        if (!response.ok || payload.success === false) {
          appendMessage('bot', payload.message || 'AI sedang tidak dapat menjawab. Silakan coba lagi.', 'error');
          return;
        }

        const reply = payload.data && payload.data.reply ? payload.data.reply : 'Maaf, saya belum bisa menjawab itu.';
        appendMessage('bot', reply);
        remember(message, reply);
      } catch (error) {
        typing.remove();
        appendMessage('bot', 'Tidak dapat terhubung ke server. Periksa koneksi internet lalu coba lagi.', 'error');
      } finally {
        chatInput.disabled = false;
        chatButton.disabled = false;
        chatButton.textContent = 'Kirim';
        chatInput.focus();
      }
    };
    let cart = [];
    const renderCart = () => { const container = document.getElementById('cartItems'); container.innerHTML = cart.length ? cart.map((item, index) => `<div class="cart-item"><div class="cart-info"><strong>${item.name}</strong><br><small>Rp ${item.price.toLocaleString('id-ID')} × ${item.quantity}</small></div><div class="cart-actions"><button onclick="changeQuantity(${index}, -1)">−</button><span>${item.quantity}</span><button onclick="changeQuantity(${index}, 1)">+</button><button class="remove" onclick="removeItem(${index})">×</button></div></div>`).join('') : '<p class="muted">Keranjang masih kosong.</p>'; document.getElementById('cartTotal').textContent = `Rp ${cart.reduce((total, item) => total + item.price * item.quantity, 0).toLocaleString('id-ID')}`; };
    window.changeQuantity = (index, amount) => { cart[index].quantity += amount; if (cart[index].quantity <= 0) cart.splice(index, 1); renderCart(); };
    window.removeItem = index => { cart.splice(index, 1); renderCart(); };
    document.getElementById('calculate').onclick = () => { cart = [...document.querySelectorAll('.quantity')].filter(input => Number(input.value) > 0).map(input => ({ name: input.dataset.name, price: Number(input.dataset.price), quantity: Number(input.value) })); if (!cart.length) return alert('Pilih minimal satu makanan.'); document.getElementById('cart').classList.remove('hidden'); document.getElementById('result').innerHTML = ''; renderCart(); };
    document.getElementById('continueOrder').onclick = () => { if (!cart.length) return alert('Keranjang masih kosong.'); document.getElementById('result').innerHTML = `<div class="result">Pesanan dikonfirmasi. Total: <strong>Rp ${cart.reduce((total, item) => total + item.price * item.quantity, 0).toLocaleString('id-ID')}</strong><br><small>Silakan lanjut ke proses pembayaran atau hubungi penjual.</small></div>`; };
  </script>
</body>
</html>
